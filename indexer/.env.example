# Copy to .env to override defaults. Defaults work out of the box.
# Tenderly public gateway serves historical Sepolia logs; the publicnode
# Sepolia RPC prunes old log history, so do NOT use it for backfill.
RPC_URL=https://sepolia.gateway.tenderly.co
PORT=3001
START_BLOCK=12055000
# Marketplace contract is NOT deployed yet — leave empty until it is.
MARKETPLACE_ADDRESS=
DB_PATH=./data/indexer.db
POLL_MS=12000
