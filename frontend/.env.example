# Local dev against the anvil (default)
VITE_NETWORK=local
VITE_FACTORY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545

# Sepolia (set VITE_NETWORK=sepolia and the real factory address after deployment)
# VITE_NETWORK=sepolia
# VITE_FACTORY_ADDRESS=0x...
# VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Marketplace (Phase 4). Leave commented until the marketplace contract is
# deployed via marketplace-deploy/ — then set the real address. The indexer
# URL defaults to a local indexer on port 3001 (see indexer/).
# VITE_MARKETPLACE_ADDRESS=0x...
# VITE_INDEXER_URL=http://localhost:3001
