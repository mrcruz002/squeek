# Copy this file to `.env` and fill in your deployer private key.
# NEVER send this file or the key to anyone, including Koda.
# The scripts abort unless the key belongs to the wallet below.

# Private key of the Sepolia deployer wallet (0x3ade5ce6a61c5a22dbb509cb847960759c88d35d).
# Same key as your Squeekchain claim script and marketplace deploy use. 0x prefix is fine.
PRIVATE_KEY=

# Registry address — leave empty until the registry is deployed, then paste it
# here (deploy.mjs writes it to deployment.json; copy it from there).
# REGISTRY_ADDRESS=

# Optional overrides (defaults are fine — only change these if you know why):
# EXPECTED_DEPLOYER=0x3ade5ce6a61c5a22dbb509cb847960759c88d35d
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# DRY_RUN=1
